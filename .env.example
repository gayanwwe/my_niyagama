# Copy to .env and fill in. Never commit the real .env.

# --- Required in production ---
# Signing key for session tokens. The server refuses to start in production
# without it. Generate one with: openssl rand -hex 32
JWT_SECRET=

# --- Optional ---
NODE_ENV=development
PORT=3000

# How long a session token stays valid (default 8h).
JWT_EXPIRES_IN=8h

# Comma-separated origins allowed to call the API cross-origin. Leave unset for
# a same-origin deployment, which is the normal setup.
CORS_ORIGIN=

# Max request body size (default 25mb). Uploads are base64 JSON.
JSON_BODY_LIMIT=25mb

# Server-side key for the AI features. This must NOT be exposed to the browser;
# the frontend calls /api/ai/generate instead.
GEMINI_API_KEY=

# --- Database ---
# Leave DB_HOST unset to use SQLite. Setting it switches to MySQL.
DB_CONNECTION=sqlite
DB_DATABASE=./niyagama_db.sqlite
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
